# --- LightTrace server ---
# Ingest keys (comma-separated). Required. Only these are accepted; give each app its own.
LIGHTTRACE_API_KEYS=change-me-long-random-key
# UI admin password. Required.
LIGHTTRACE_PASSWORD=change-me
# Bind address/port. Keep 127.0.0.1 unless a reverse proxy or Docker needs otherwise.
LIGHTTRACE_HOST=127.0.0.1
LIGHTTRACE_PORT=1984
# Storage: a SQLite file path, or a Postgres URL (pip install 'lighttrace[postgres]').
LIGHTTRACE_DB=lighttrace.db
# LIGHTTRACE_DB=postgresql://lighttrace:secret@db.example.com:5432/lighttrace
# Delete traces older than N days, checked hourly. 0 = keep forever.
LIGHTTRACE_RETENTION_DAYS=30
# Optional cost tracking: USD per 1M input / output tokens, by model name (exact or prefix match).
# Inline JSON or a path to a .json file. Leave empty to hide cost columns.
# Use your provider's current prices; these numbers are placeholders.
# LIGHTTRACE_PRICES={"my-model-name": [1.00, 4.00], "my-model-prefix": [0.50, 2.00]}
# Set true when the UI is served over HTTPS so the session cookie is Secure.
LIGHTTRACE_COOKIE_SECURE=false
# Max request body (MB, after gzip decompression).
LIGHTTRACE_MAX_BODY_MB=50

# --- in your app (not here) ---
# With lighttrace.register():
# LIGHTTRACE_ENDPOINT=http://127.0.0.1:1984
# LIGHTTRACE_API_KEY=<one of LIGHTTRACE_API_KEYS>
# LIGHTTRACE_PROJECT=myapp           # the project; created on its first trace
# Or any OpenTelemetry exporter, without the LightTrace package:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:1984
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<one of LIGHTTRACE_API_KEYS>
# OTEL_SERVICE_NAME=myapp
